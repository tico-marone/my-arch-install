/* Spacious centered grid, zero clipping on right pane, calm unfocused buttons, TTY-safe contrast */

* {
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
    scrollbar-gutter: auto;
    scrollbar-color: #2655d8;
    scrollbar-color-hover: #18d4d4;
    scrollbar-color-active: #18d4d4;
    scrollbar-background: #686868;
    scrollbar-background-hover: #686868;
    scrollbar-background-active: #686868;
}

Screen {
    align: center middle;
    background: $background;
    color: $foreground;
}

#window-frame {
    width: 96%;
    max-width: 152;
    min-width: 76;
    height: 94%;
    max-height: 46;
    min-height: 22;
    border: solid $primary;
    background: $background;
    layout: vertical;
}

#window-header {
    height: 3;
    padding: 0 2;
    background: $surface;
    border-bottom: solid #686868;
    layout: horizontal;
    align-vertical: middle;
}

#header-title {
    width: 1fr;
    text-style: bold;
    color: $foreground;
}

#header-badges {
    width: auto;
    color: $accent;
    text-style: bold;
}

#grid-body {
    layout: grid;
    grid-size: 2;
    grid-columns: 56fr 44fr;
    grid-gutter: 0 2;
    height: 1fr;
    padding: 1 2;
}

#left-pane, #right-pane {
    height: 1fr;
    width: 100%;
    border: solid #686868;
    padding: 1 2;
    background: $surface;
}

#left-pane:focus-within, #right-pane:focus-within {
    border: solid $accent;
}

.pane-heading {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.field-label {
    margin-top: 1;
    color: $foreground;
    text-style: bold;
}

.hint-text {
    color: #a8a8a8;
    margin-bottom: 1;
}

.error-text {
    color: $error;
    text-style: bold;
}

.ok-text {
    color: $success;
    text-style: bold;
}

.warn-text {
    color: $warning;
    text-style: bold;
}

#root-pw-section {
    height: auto;
    layout: vertical;
}

#root-pw-section.hidden {
    display: none;
}

#window-frame Input,
#modal-box Input {
    border: solid #686868;
    height: 3;
    padding: 0 1;
    background: $background;
    color: $foreground;
}

#window-frame Input:focus,
#modal-box Input:focus {
    border: solid $accent;
    background: $background;
    color: #ffffff;
}

#window-frame Input:disabled,
#modal-box Input:disabled {
    border: solid #686868;
    color: #686868;
}

/* Calm uniform gray for ALL unfocused buttons; only focused buttons highlight */

#window-frame Button,
#window-frame Button:hover,
#window-frame Button.-active,
#window-frame Button.-primary,
#window-frame Button.-primary:hover,
#window-frame Button.-primary.-active,
#window-frame Button.-success,
#window-frame Button.-success:hover,
#window-frame Button.-success.-active,
#window-frame Button.-error,
#window-frame Button.-error:hover,
#window-frame Button.-error.-active,
#modal-box Button,
#modal-box Button:hover,
#modal-box Button.-active,
#modal-box Button.-primary,
#modal-box Button.-primary:hover,
#modal-box Button.-primary.-active,
#modal-box Button.-error,
#modal-box Button.-error:hover,
#modal-box Button.-error.-active {
    border: none;
    height: 1;
    min-width: 10;
    padding: 0 2;
    background: #686868;
    color: #e5e5e5;
    text-style: none;
}

#window-frame Button:focus,
#modal-box Button:focus {
    border: none;
    background: $primary;
    color: #ffffff;
    text-style: bold;
}

#window-frame Button.-primary:focus,
#modal-box Button.-primary:focus {
    border: none;
    background: $accent;
    color: #000000;
    text-style: bold;
}

#window-frame Button.-success:focus {
    border: none;
    background: $success;
    color: #000000;
    text-style: bold;
}

#window-frame Button.-error:focus,
#modal-box Button.-error:focus {
    border: none;
    background: $error;
    color: #ffffff;
    text-style: bold;
}

#window-frame Button:disabled,
#modal-box Button:disabled {
    border: none;
    background: #000000;
    color: #686868;
    text-style: none;
}

#tab-bar {
    layout: horizontal;
    height: 1;
    margin-bottom: 1;
}

#window-frame .tab-btn,
#window-frame .tab-btn:hover {
    border: none;
    height: 1;
    padding: 0 2;
    margin-right: 1;
    background: #686868;
    color: #e5e5e5;
}

#window-frame .tab-btn.active,
#window-frame .tab-btn.active:hover {
    border: none;
    background: $primary;
    color: #ffffff;
    text-style: bold;
}

#window-frame .tab-btn:focus {
    border: none;
    background: $accent;
    color: #000000;
    text-style: bold;
}

ContentSwitcher {
    height: 1fr;
}

.switcher-pane {
    height: 1fr;
    layout: vertical;
}

CleanToggle {
    height: 1;
    margin-top: 1;
    padding: 0 1;
    background: $background;
    color: $foreground;
}

CleanToggle:focus {
    background: $primary;
    color: #ffffff;
    text-style: bold;
}

OptionList {
    height: 1fr;
    margin-top: 1;
    border: none;
    padding: 0;
    background: $surface;
    color: $foreground;
}

OptionList > .option-list--option {
    padding: 0 1;
}

OptionList > .option-list--option-highlighted {
    background: #686868;
    color: #ffffff;
    text-style: bold;
}

OptionList:focus > .option-list--option-highlighted {
    background: $primary;
    color: #ffffff;
    text-style: bold;
}

OptionList > .option-list--option-disabled {
    color: $accent;
    text-style: bold;
}

.button-row {
    layout: horizontal;
    height: 1;
    margin-top: 1;
}

.button-row Button {
    margin-right: 1;
}

#window-footer {
    height: 3;
    padding: 0 2;
    background: $surface;
    border-top: solid #686868;
    layout: horizontal;
    align-vertical: middle;
}

#footer-keys {
    width: 1fr;
    color: #a8a8a8;
}

#footer-actions {
    width: auto;
    height: 1;
    layout: horizontal;
}

#footer-actions Button {
    margin-left: 1;
}

/* Progress Screen: Vertical layout (not nested VerticalScroll) so Log scrolls smoothly */

#progress-body {
    height: 1fr;
    padding: 1 3;
    layout: vertical;
}

.progress-section-title {
    text-style: bold;
    color: $accent;
    margin-top: 1;
}

CleanProgressBar {
    height: 1;
    width: 100%;
    margin-bottom: 1;
}

#steps-box {
    border: solid #686868;
    background: $surface;
    padding: 1 2;
    height: auto;
    margin-top: 1;
}

#log-drawer {
    height: 1fr;
    min-height: 7;
    border: solid #686868;
    background: $background;
    margin-top: 1;
    display: none;
}

#log-drawer:focus {
    border: solid $accent;
}

#log-drawer.visible {
    display: block;
}

#error-banner {
    border: solid $error;
    background: $surface;
    color: $error;
    padding: 1 2;
    height: auto;
    margin-top: 1;
    display: none;
}

#error-banner.visible {
    display: block;
}

#modal-box {
    width: 72;
    max-width: 92%;
    height: auto;
    border: solid $warning;
    background: $background;
    padding: 1 2;
}

#modal-title {
    text-style: bold;
    color: $warning;
    margin-bottom: 1;
}

#modal-actions {
    layout: horizontal;
    height: 1;
    margin-top: 1;
    align-horizontal: right;
}

#modal-actions Button {
    margin-left: 1;
}
