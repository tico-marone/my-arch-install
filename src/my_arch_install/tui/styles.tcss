/* Complete UI rewrite: spacious centered grid, zero 1/8th-block '#' artifacts, TTY-safe contrast */

* {
    scrollbar-size-vertical: 1;
    scrollbar-size-horizontal: 1;
    scrollbar-gutter: auto;
    scrollbar-color: #2655d8;
    scrollbar-color-hover: #18d4d4;
    scrollbar-color-active: #18d4d4;
    scrollbar-background: #686868;
    scrollbar-background-hover: #686868;
    scrollbar-background-active: #686868;
}

Screen {
    align: center middle;
    background: $background;
    color: $foreground;
}

#window-frame {
    width: 96%;
    max-width: 152;
    min-width: 76;
    height: 94%;
    max-height: 46;
    min-height: 22;
    border: solid $primary;
    background: $background;
    layout: vertical;
}

#window-header {
    height: 3;
    padding: 0 2;
    background: $surface;
    border-bottom: solid #686868;
    layout: horizontal;
    align-vertical: middle;
}

#header-title {
    width: 1fr;
    text-style: bold;
    color: $foreground;
}

#header-badges {
    width: auto;
    color: $accent;
    text-style: bold;
}

#grid-body {
    layout: grid;
    grid-size: 2;
    grid-columns: 56% 44%;
    grid-gutter: 0 2;
    height: 1fr;
    padding: 1 2;
}

#left-pane, #right-pane {
    height: 1fr;
    border: solid #686868;
    padding: 1 2;
    background: $surface;
}

#left-pane:focus-within, #right-pane:focus-within {
    border: solid $accent;
}

.pane-heading {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.field-label {
    margin-top: 1;
    color: $foreground;
    text-style: bold;
}

.hint-text {
    color: #a8a8a8;
    margin-bottom: 1;
}

.error-text {
    color: $error;
    text-style: bold;
}

.ok-text {
    color: $success;
    text-style: bold;
}

.warn-text {
    color: $warning;
    text-style: bold;
}

Input {
    border: solid #686868;
    height: 3;
    padding: 0 1;
    background: $background;
    color: $foreground;
}

Input:focus {
    border: solid $accent;
    background: $background;
    color: #ffffff;
}

Input:disabled {
    border: solid #686868;
    color: #686868;
}

Button {
    border: none;
    height: 1;
    min-width: 10;
    padding: 0 2;
    background: #686868;
    color: #ffffff;
}

Button:focus {
    background: $primary;
    color: #ffffff;
    text-style: bold;
}

Button.-primary {
    background: $secondary;
    color: #ffffff;
}

Button.-primary:focus {
    background: $accent;
    color: #000000;
    text-style: bold;
}

Button.-success {
    background: $success;
    color: #000000;
    text-style: bold;
}

Button.-success:focus {
    background: $accent;
    color: #000000;
    text-style: bold;
}

Button.-error {
    background: $error;
    color: #ffffff;
    text-style: bold;
}

Button.-error:focus {
    background: #ffffff;
    color: #000000;
    text-style: bold;
}

Button:disabled {
    background: #000000;
    color: #686868;
}

#tab-bar {
    layout: horizontal;
    height: 1;
    margin-bottom: 1;
}

.tab-btn {
    border: none;
    height: 1;
    padding: 0 2;
    margin-right: 1;
    background: #686868;
    color: #e5e5e5;
}

.tab-btn.active {
    background: $primary;
    color: #ffffff;
    text-style: bold;
}

.tab-btn:focus {
    background: $accent;
    color: #000000;
    text-style: bold;
}

ContentSwitcher {
    height: 1fr;
}

.switcher-pane {
    height: 1fr;
    layout: vertical;
}

CleanToggle {
    height: 1;
    margin-top: 1;
    padding: 0 1;
    background: $background;
    color: $foreground;
}

CleanToggle:focus {
    background: $primary;
    color: #ffffff;
    text-style: bold;
}

OptionList {
    height: 1fr;
    margin-top: 1;
    border: none;
    padding: 0;
    background: $surface;
    color: $foreground;
}

OptionList > .option-list--option {
    padding: 0 1;
}

OptionList > .option-list--option-highlighted {
    background: #686868;
    color: #ffffff;
    text-style: bold;
}

OptionList:focus > .option-list--option-highlighted {
    background: $primary;
    color: #ffffff;
    text-style: bold;
}

OptionList > .option-list--option-disabled {
    color: $accent;
    text-style: bold;
}

.button-row {
    layout: horizontal;
    height: 1;
    margin-top: 1;
}

.button-row Button {
    margin-right: 1;
}

#window-footer {
    height: 3;
    padding: 0 2;
    background: $surface;
    border-top: solid #686868;
    layout: horizontal;
    align-vertical: middle;
}

#footer-keys {
    width: 1fr;
    color: #a8a8a8;
}

#footer-actions {
    width: auto;
    height: 1;
    layout: horizontal;
}

#footer-actions Button {
    margin-left: 1;
}

#progress-body {
    height: 1fr;
    padding: 1 3;
    layout: vertical;
}

.progress-section-title {
    text-style: bold;
    color: $accent;
    margin-top: 1;
}

CleanProgressBar {
    height: 1;
    width: 100%;
    margin-bottom: 1;
}

#steps-box {
    border: solid #686868;
    background: $surface;
    padding: 1 2;
    height: auto;
    margin-top: 1;
}

#log-drawer {
    height: 12;
    border: solid #686868;
    background: $background;
    margin-top: 1;
    display: none;
}

#log-drawer.visible {
    display: block;
}

#error-banner {
    border: solid $error;
    background: $surface;
    color: $error;
    padding: 1 2;
    margin-top: 1;
    display: none;
}

#error-banner.visible {
    display: block;
}

#modal-box {
    width: 72;
    max-width: 92%;
    height: auto;
    border: solid $warning;
    background: $background;
    padding: 1 2;
}

#modal-title {
    text-style: bold;
    color: $warning;
    margin-bottom: 1;
}

#modal-actions {
    layout: horizontal;
    height: 1;
    margin-top: 1;
    align-horizontal: right;
}

#modal-actions Button {
    margin-left: 1;
}
